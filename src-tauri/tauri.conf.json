{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:8080",
    "distDir": "../dist"
  },
  "package": {
    "productName": "MKV Batch Muxing Tool",
    "version": "1.23.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true,
        "save": true
      },
      "fs": {
        "all": true
      },
      "path": {
        "all": true
      },
      "shell": {
        "open": true
      },
      "window": {
        "all": true
      }
    },
    "bundle": {
      "identifier": "com.ionicboy.mkvbatchmuxingtool",
      "targets": [
        "msi",
        "dmg",
        "deb",
        "appimage",
        "updater"
      ],
      "icon": [
        "icons/icon.png",
        "icons/icon.ico"
      ],
      "resources": [
        "resources/engine"
      ]
    },
    "windows": [
      {
        "title": "MKV Batch Muxing Tool",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "maximized": false,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/AdkHex/MkvBatchMux/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGRDBBQUEwQkZENEE3QzQKUldURXA5Uy9vS3JRWHkvbVV4eE01QzM1TlVybnZUNHgzMENvREpLNHlDdnhUamNaeXRTSXhneTcK"
    }
  }
}
