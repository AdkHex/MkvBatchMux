{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:8080",
    "distDir": "../dist"
  },
  "package": {
    "productName": "MKVBatchMux",
    "version": "1.30.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "open": true,
        "save": true
      },
      "fs": {
        "all": true
      },
      "path": {
        "all": true
      },
      "shell": {
        "open": true
      },
      "window": {
        "all": true
      },
      "process": {
        "relaunch": true
      }
    },
    "bundle": {
      "identifier": "com.ionicboy.mkvbatchmuxingtool",
      "targets": [
        "nsis",
        "updater"
      ],
      "icon": [
        "icons/icon.png",
        "icons/icon.ico"
      ],
      "resources": [
        "resources/engine",
        "resources/ffmpeg"
      ],
      "active": true,
      "windows": {
        "nsis": {
          "installMode": "perMachine",
          "languages": [
            "English"
          ]
        }
      }
    },
    "windows": [
      {
        "title": "MKVBatchMux",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "maximized": false,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/AdkHex/MkvBatchMux/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGRDBBQUEwQkZENEE3QzQKUldURXA5Uy9vS3JRWHkvbVV4eE01QzM1TlVybnZUNHgzMENvREpLNHlDdnhUamNaeXRTSXhneTcK"
    }
  }
}
